{
  "name": "review-app",
  "version": "1.0.0",
  "private": true,
  "description": "适配 iPhone 的个人复习网站：导入题库、答题、错题重练、学习记录、数据导出与恢复",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.js",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
